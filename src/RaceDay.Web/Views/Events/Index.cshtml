@model EventBrowseViewModel
@{ ViewData["Title"] = "Events"; }
<div class="container section">
    <h1>Browse events</h1>
    <form method="get" class="filters-bar">
        <div class="form-group" style="flex:2;margin-bottom:0">
            <label>Search</label>
            <input type="text" name="search" value="@Model.Search" placeholder="Search events..." />
        </div>
        <div class="form-group" style="margin-bottom:0">
            <label>Type</label>
            <select name="type">
                <option value="">All types</option>
                @foreach (var t in Enum.GetValues<EventType>())
                {
                    <option value="@t" selected="@(Model.Type == t)">@t</option>
                }
            </select>
        </div>
        <div class="form-group" style="margin-bottom:0">
            <label>Location</label>
            <input type="text" name="location" value="@Model.Location" placeholder="City..." />
        </div>
        <div class="form-group" style="margin-bottom:0">
            <label>From</label>
            <input type="date" name="from" value="@Model.From?.ToString("yyyy-MM-dd")" />
        </div>
        <div class="form-group" style="margin-bottom:0">
            <label>To</label>
            <input type="date" name="to" value="@Model.To?.ToString("yyyy-MM-dd")" />
        </div>
        <button type="submit" class="btn btn-primary">Filter</button>
    </form>

    @if (!Model.Events.Any())
    {
        <div class="empty-state">No events match your filters.</div>
    }
    else
    {
        <div class="event-grid">
            @foreach (var ev in Model.Events)
            {
                <partial name="_EventCard" model="ev" />
            }
        </div>
    }
</div>
