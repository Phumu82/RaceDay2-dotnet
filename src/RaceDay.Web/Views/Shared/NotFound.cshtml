@{ ViewData["Title"] = "Page Not Found"; }
<div class="container section" style="text-align:center;padding:5rem 1rem">
    <p class="display" style="font-size:5rem;color:var(--raceday-accent);margin:0">404</p>
    <h1 style="margin-top:.5rem">Page Not Found</h1>
    <p class="text-muted" style="max-width:360px;margin:.5rem auto 1.5rem">The page you're looking for doesn't exist or has moved.</p>
    <div style="display:flex;gap:.75rem;justify-content:center">
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Go home</a>
        <a class="btn btn-outline" href="javascript:history.back()">Go back</a>
    </div>
</div>
